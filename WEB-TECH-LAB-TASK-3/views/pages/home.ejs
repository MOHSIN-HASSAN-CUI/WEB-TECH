
<!-- Hero Section -->
<section class="hero-section">
    <div class="container text-center">
        <h1>INSPIRED BY LIFE</h1>
        <h2>All you need in 1 place</h2>
        <div class="hero-cta">
            <a href="/products" class="btn btn-primary btn-large">Shop Golf Equipment</a>
        </div>
    </div>
</section>

<!-- Featured Products -->
<section class="featured-products">
    <div class="container">
        <h2 class="text-center">Featured Products</h2>
        <p class="text-center section-subtitle">Check out our best-selling golf equipment</p>
        
        <div class="featured-grid">
            <% if (featuredProducts && featuredProducts.length > 0) { %>
                <% featuredProducts.forEach(product => { %>
                    <div class="featured-product">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <h4><%= product.name %></h4>
                        <p class="price">$<%= product.price.toFixed(2) %></p>
                        <a href="/products/<%= product._id %>" class="btn btn-outline">View Details</a>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-center">No featured products available</p>
            <% } %>
        </div>
        
        <div class="text-center" style="margin-top: 40px;">
            <a href="/products" class="btn btn-primary">View All Products</a>
        </div>
    </div>
</section>

<script>
$(document).ready(function() {
    // Load featured products via API
    $.get('/api/products/search?featured=true&limit=3', function(data) {
        // Update featured products section
    });
});
</script>