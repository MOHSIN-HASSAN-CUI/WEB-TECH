<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin Panel - 1GOLF BeGOLF' %></title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Admin Custom CSS -->
    <link rel="stylesheet" href="/css/admin.css">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Toastr for notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</head>
<body class="admin-body">
    <!-- Admin Sidebar -->
    <div class="admin-wrapper">
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <h3 class="text-center">
                    <i class="bi bi-gear-fill me-2"></i>
                    Admin Panel
                </h3>
                <p class="text-center text-muted small">1GOLF BeGOLF</p>
            </div>
            
            <ul class="list-unstyled components">
                <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                    <a href="/admin/dashboard">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                </li>
                <li class="<%= activePage === 'products' ? 'active' : '' %>">
                    <a href="/admin/products">
                        <i class="bi bi-box-seam"></i>
                        Products
                    </a>
                </li>
                <li>
                    <a href="/admin/orders">
                        <i class="bi bi-cart-check"></i>
                        Orders
                    </a>
                </li>
                <li>
                    <a href="/admin/users">
                        <i class="bi bi-people"></i>
                        Users
                    </a>
                </li>
                <li>
                    <a href="/admin/categories">
                        <i class="bi bi-tags"></i>
                        Categories
                    </a>
                </li>
                <li>
                    <a href="/">
                        <i class="bi bi-arrow-left"></i>
                        Back to Site
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <div class="user-info">
                    <i class="bi bi-person-circle"></i>
                    <span>Admin User</span>
                </div>
                <a href="/admin/logout" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </nav>
        
        <!-- Page Content -->
        <div id="content">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg admin-navbar">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-light">
                        <i class="bi bi-list"></i>
                    </button>
                    
                    <div class="navbar-nav ms-auto">
                        <span class="navbar-text me-3">
                            <i class="bi bi-calendar-event"></i>
                            <span id="current-date"></span>
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-bell"></i>
                                <span class="badge bg-danger">3</span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">New order received</a></li>
                                <li><a class="dropdown-item" href="#">Low stock alert</a></li>
                                <li><a class="dropdown-item" href="#">New user registered</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
            
            <!-- Main Content -->
            <div class="container-fluid mt-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                        <% if (breadcrumb) { %>
                            <% breadcrumb.forEach(function(item) { %>
                                <li class="breadcrumb-item <%= item.active ? 'active' : '' %>">
                                    <% if (item.link) { %>
                                        <a href="<%= item.link %>"><%= item.text %></a>
                                    <% } else { %>
                                        <%= item.text %>
                                    <% } %>
                                </li>
                            <% }); %>
                        <% } %>
                    </ol>
                </nav>
                
                <!-- Page Title -->
                <% if (pageTitle) { %>
                    <div class="page-header mb-4">
                        <h2 class="page-title"><%= pageTitle %></h2>
                        <% if (pageSubtitle) { %>
                            <p class="text-muted"><%= pageSubtitle %></p>
                        <% } %>
                    </div>
                <% } %>
                
                <!-- Main Content Area -->
                <%- body %>
            </div>
            
            <!-- Footer -->
            <footer class="admin-footer mt-5">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-0">&copy; 2024 1GOLF BeGOLF Admin Panel. All rights reserved.</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="text-muted">v1.0.0 | Server: <span id="server-status" class="badge bg-success">Online</span></span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    
    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Admin Custom JS -->
    <script src="/js/admin.js"></script>
    
    <script>
        // Initialize toastr
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
        
        // Set current date
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('current-date').textContent = now.toLocaleDateString('en-US', options);
        
        // Sidebar toggle
        $(document).ready(function() {
            $('#sidebarCollapse').on('click', function() {
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
            });
            
            // Auto-hide notifications after 5 seconds
            $('.alert').delay(5000).fadeOut('slow');
        });
    </script>
    

</body>
</html>