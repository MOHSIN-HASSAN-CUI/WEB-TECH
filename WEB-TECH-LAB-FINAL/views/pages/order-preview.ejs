<section class="order-preview-section">
    <div class="container">
        <h1>Order Preview</h1>
        <p class="section-subtitle">Review your order before placing</p>

        <!-- Cart Items -->
        <div class="cart-summary">
            <h3>Order Summary</h3>

            <% if (items.length> 0) { %>
                <div class="order-items">
                    <% items.forEach(item=> { %>
                        <div class="order-item">
                            <div class="item-info">
                                <h4>
                                    <%= item.name %>
                                </h4>
                                <p>Price: $<%= item.price.toFixed(2) %> × <%= item.quantity %>
                                </p>
                            </div>
                            <div class="item-subtotal">
                                $<%= item.subtotal.toFixed(2) %>
                            </div>
                        </div>
                        <% }); %>
                </div>

                <div class="order-totals">
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>$<%= subtotal %></span>
                    </div>

                    <% if (hasCoupon) { %>
                        <div class="total-row discount">
                            <span>Discount (<%= discountPercent %>%):</span>
                            <span>-$<%= discountAmount %></span>
                        </div>
                        <% } %>

                            <div class="total-row grand-total">
                                <span>Grand Total:</span>
                                <span>$<%= total %></span>
                            </div>
                </div>

                <!-- Coupon Section -->
                <div class="coupon-section">
                    <form action="/order/preview" method="GET" class="coupon-form">
                        <input type="text" name="coupon" placeholder="Enter coupon code" value="<%= couponCode %>">
                        <button type="submit" class="btn btn-secondary">Apply</button>
                    </form>
                    <% if (hasCoupon) { %>
                        <p class="coupon-success">
                            <i class="fas fa-check-circle"></i> Coupon <strong>
                                <%= couponCode %>
                            </strong> applied! You saved $<%= discountAmount %>
                        </p>
                        <% } %>
                            <% if (locals.couponError) { %>
                                <div class="alert alert-danger mt-2 mb-0 py-2">
                                    <i class="fas fa-times-circle"></i>
                                    <%= couponError %>
                                </div>
                                <% } %>
                </div>

                <!-- Action Buttons -->
                <div class="order-actions">
                    <form action="/order/place" method="POST">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address *</label>
                            <input type="email" class="form-control" id="email" name="email" required
                                placeholder="Enter your email for order confirmation">
                        </div>

                        <div class="d-flex gap-3">
                            <a href="/cart" class="btn btn-outline-secondary">
                                ← Go Back to Cart
                            </a>
                            <button type="submit" class="btn btn-success">
                                Confirm Order →
                            </button>
                        </div>
                    </form>
                </div>
                <% } else { %>
                    <p>Your cart is empty</p>
                    <a href="/shop" class="btn btn-primary">Continue Shopping</a>
                    <% } %>
        </div>
    </div>
</section>

<style>
    .order-preview-section {
        padding: 40px 0;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        padding: 15px;
        border-bottom: 1px solid #eee;
    }

    .order-totals {
        margin: 20px 0;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
        padding: 5px 0;
    }

    .total-row.discount {
        color: #28a745;
    }

    .total-row.grand-total {
        border-top: 2px solid #dee2e6;
        padding-top: 15px;
        margin-top: 15px;
        font-size: 1.2em;
        font-weight: bold;
    }

    .coupon-section {
        margin: 20px 0;
        padding: 15px;
        background: #fff3cd;
        border-radius: 8px;
    }

    .coupon-form {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

    .coupon-success {
        color: #155724;
        margin: 0;
    }

    .order-actions {
        margin-top: 30px;
    }
</style>