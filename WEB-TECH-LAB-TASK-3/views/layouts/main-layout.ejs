<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || '1GOLF BeGOLF' %></title>
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/styles.css">
    
    <!-- jQuery for checkout page -->
    <% if (activePage === 'checkout' || activePage === 'admin') { %>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <% } %>
    
    <!-- Bootstrap for admin page -->
    <% if (activePage === 'admin') { %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <% } %>
</head>
<body>
    <!-- Header/Navbar -->
    <%- include('../partials/header') %>
    
    <!-- Main Content -->
    <main>
        <%- body %>
    </main>
    
    <!-- Footer -->
    <%- include('../partials/footer') %>
    
    <!-- Page-specific scripts -->
    <% if (activePage === 'home') { %>
    <script>
        // Testimonials functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Your testimonials JavaScript from index.html
            const testimonialsGrid = document.getElementById('testimonials-grid');
            const viewMoreBtn = document.getElementById('view-more-btn');
            const viewLessBtn = document.getElementById('view-less-btn');
            const testimonialCards = document.querySelectorAll('.testimonial-card');
            
            let isShowingAll = false;

            if (viewMoreBtn) {
                viewMoreBtn.addEventListener('click', function() {
                    showAllTestimonials();
                });
            }
            
            if (viewLessBtn) {
                viewLessBtn.addEventListener('click', function() {
                    showLimitedTestimonials();
                });
            }
            
            function showAllTestimonials() {
                testimonialsGrid.classList.add('show-all');
                testimonialCards.forEach(card => {
                    card.style.display = 'block';
                });
                
                if (viewMoreBtn) viewMoreBtn.style.display = 'none';
                if (viewLessBtn) viewLessBtn.style.display = 'inline-block';
                isShowingAll = true;
            }
            
            function showLimitedTestimonials() {
                testimonialsGrid.classList.remove('show-all');
                testimonialCards.forEach((card, index) => {
                    if (index >= 2) {
                        card.style.display = 'none';
                    }
                });
                
                if (viewMoreBtn) viewMoreBtn.style.display = 'inline-block';
                if (viewLessBtn) viewLessBtn.style.display = 'none';
                isShowingAll = false;
            }
            
            // Initialize
            showLimitedTestimonials();
            
            // Hover effect
            testimonialsGrid.addEventListener('mouseenter', function() {
                if (!isShowingAll) {
                    testimonialCards.forEach(card => {
                        card.style.display = 'block';
                    });
                }
            });
            
            testimonialsGrid.addEventListener('mouseleave', function() {
                if (!isShowingAll) {
                    testimonialCards.forEach((card, index) => {
                        if (index >= 2) {
                            card.style.display = 'none';
                        }
                    });
                }
            });
        });
    </script>
    <% } %>
    
    <% if (activePage === 'shop') { %>
    <script>
        // Cart functionality for products page
        document.addEventListener('DOMContentLoaded', function() {
            let cart = JSON.parse(localStorage.getItem('golfCart')) || [];
            
            document.querySelectorAll('.add-to-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const product = this.getAttribute('data-product');
                    const price = parseFloat(this.getAttribute('data-price'));
                    
                    cart.push({ product, price });
                    updateCartDisplay();
                    
                    alert(`${product} added to cart!`);
                });
            });
            
            function updateCartDisplay() {
                const cartItems = document.getElementById('cart-items');
                const cartTotal = document.getElementById('cart-total');
                const checkoutBtn = document.querySelector('.checkout-btn');
                
                if (cart.length === 0) {
                    cartItems.innerHTML = '<p>Your cart is empty</p>';
                    if (checkoutBtn) checkoutBtn.style.display = 'none';
                } else {
                    let itemsHTML = '';
                    let total = 0;
                    
                    cart.forEach(item => {
                        itemsHTML += `<div class="cart-item">${item.product} - $${item.price.toFixed(2)}</div>`;
                        total += item.price;
                    });
                    
                    cartItems.innerHTML = itemsHTML;
                    cartTotal.textContent = total.toFixed(2);
                    if (checkoutBtn) checkoutBtn.style.display = 'block';
                    
                    localStorage.setItem('golfCart', JSON.stringify(cart));
                }
            }
            
            updateCartDisplay();
        });
    </script>
    <% } %>
    
    <% if (activePage === 'cart') { %>
    <script>
        // Cart page functionality
        let cart = JSON.parse(localStorage.getItem('golfCart')) || [];
        const cartContent = document.getElementById('cart-content');
        const checkoutBtn = document.getElementById('checkout-btn');

        function updateCartDisplay() {
            if (cart.length === 0) {
                cartContent.innerHTML = `
                    <div class="empty-cart">
                        <h3>Your cart is empty</h3>
                        <p>Browse our products and add some items to your cart!</p>
                    </div>
                `;
                if (checkoutBtn) checkoutBtn.style.display = 'none';
            } else {
                let cartHTML = `
                    <div class="cart-items">
                        <div class="cart-header">
                            <span>Product</span>
                            <span>Price</span>
                            <span>Action</span>
                        </div>
                `;
                
                let total = 0;
                
                cart.forEach((item, index) => {
                    cartHTML += `
                        <div class="cart-item">
                            <span class="product-name">${item.product}</span>
                            <span class="product-price">$${item.price.toFixed(2)}</span>
                            <button class="btn-remove" data-index="${index}">Remove</button>
                        </div>
                    `;
                    total += item.price;
                });
                
                cartHTML += `
                    </div>
                    <div class="cart-total">
                        <strong>Total: $${total.toFixed(2)}</strong>
                    </div>
                `;
                
                cartContent.innerHTML = cartHTML;
                if (checkoutBtn) checkoutBtn.style.display = 'inline-block';
                
                document.querySelectorAll('.btn-remove').forEach(button => {
                    button.addEventListener('click', function() {
                        const index = parseInt(this.getAttribute('data-index'));
                        cart.splice(index, 1);
                        localStorage.setItem('golfCart', JSON.stringify(cart));
                        updateCartDisplay();
                    });
                });
            }
        }

        updateCartDisplay();
    </script>
    <% } %>
</body>
</html>