<!-- Products Section -->
<section class="products-section">
    <div class="container">
        <h1 class="text-center">Golf Equipment & Accessories</h1>
        <p class="text-center section-subtitle">Premium golf gear for professionals and enthusiasts</p>

        <!-- Filters Section -->
        <div class="filters-section">
            <div class="row">
                <div class="col-md-12">
                    <div class="filter-card">
                        <h4>Filters</h4>
                        <div class="filter-controls">
                            <!-- Category Filter -->
                            <div class="filter-group">
                                <label>Category:</label>
                                <div class="category-filters">
                                    <a href="/shop" class="category-filter <%= !currentCategory ? 'active' : '' %>">
                                        All
                                    </a>
                                    <% categories.forEach(cat=> { %>
                                        <a href="/shop?category=<%= cat %>"
                                            class="category-filter <%= currentCategory === cat ? 'active' : '' %>">
                                            <%= cat %>
                                        </a>
                                        <% }); %>
                                </div>
                            </div>

                            <!-- Price Range Filter -->
                            <div class="filter-group">
                                <label>Price Range: $<span id="minPriceValue">
                                        <%= minPrice %>
                                    </span> - $<span id="maxPriceValue">
                                        <%= maxPrice %>
                                    </span></label>
                                <div class="price-range">
                                    <input type="range" class="form-range" id="priceRangeMin"
                                        min="<%= minPriceOverall %>" max="<%= maxPriceOverall %>"
                                        value="<%= minPrice %>">
                                    <input type="range" class="form-range" id="priceRangeMax"
                                        min="<%= minPriceOverall %>" max="<%= maxPriceOverall %>"
                                        value="<%= maxPrice %>">
                                    <div class="price-labels">
                                        <span>$<%= minPriceOverall %></span>
                                        <span>$<%= maxPriceOverall %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Sort Options -->
                            <div class="filter-group">
                                <label>Sort By:</label>
                                <select class="form-select" id="sortBy">
                                    <option value="createdAt" <%=sortBy==='createdAt' ? 'selected' : '' %>>Newest First
                                    </option>
                                    <option value="price" <%=sortBy==='price' ? 'selected' : '' %>>Price</option>
                                    <option value="name" <%=sortBy==='name' ? 'selected' : '' %>>Name</option>
                                    <option value="rating" <%=sortBy==='rating' ? 'selected' : '' %>>Rating</option>
                                </select>
                                <select class="form-select" id="sortOrder">
                                    <option value="desc" <%=sortOrder===-1 ? 'selected' : '' %>>Descending</option>
                                    <option value="asc" <%=sortOrder===1 ? 'selected' : '' %>>Ascending</option>
                                </select>
                            </div>

                            <!-- Apply Filters Button -->
                            <button class="btn btn-primary" id="applyFilters">Apply Filters</button>
                            <button class="btn btn-outline" id="resetFilters">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="products-grid" id="productsContainer">
            <% products.forEach(product=> { %>
                <div class="product-card">
                    <div class="product-image">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <% if (product.stock < 10) { %>
                            <span class="product-badge low-stock">Low Stock</span>
                            <% } %>
                    </div>
                    <div class="product-info">
                        <h3>
                            <%= product.name %>
                        </h3>
                        <p class="product-category">
                            <%= product.category %>
                        </p>
                        <p class="product-description">
                            <%= product.description %>
                        </p>
                        <div class="product-price">$<%= product.price.toFixed(2) %>
                        </div>
                        <div class="product-rating">
                            <% for (let i=1; i <=5; i++) { %>
                                <% if (i <=Math.floor(product.rating)) { %>
                                    ★
                                    <% } else if (i - 0.5 <=product.rating) { %>
                                        ☆
                                        <% } else { %>
                                            ☆
                                            <% } %>
                                                <% } %>
                                                    <span class="rating-count">(<%= product.reviews %> reviews)</span>
                        </div>
                        <div class="product-stock">
                            <% if (product.stock> 0) { %>
                                <span class="stock-available">In Stock: <%= product.stock %></span>
                                <% } else { %>
                                    <span class="stock-out">Out of Stock</span>
                                    <% } %>
                        </div>
                        <button class="btn btn-primary add-to-cart" data-id="<%= product._id %>"
                            data-product="<%= product.name %>" data-price="<%= product.price %>" <%=product.stock===0
                            ? 'disabled' : '' %>>
                            <%= product.stock===0 ? 'Out of Stock' : 'Add to Cart' %>
                        </button>
                    </div>
                </div>
                <% }); %>

                    <% if (products.length===0) { %>
                        <div class="no-products">
                            <h3>No products found</h3>
                            <p>Try adjusting your filters</p>
                        </div>
                        <% } %>
        </div>

        <!-- Pagination -->
        <% if (totalPages> 1) { %>
            <nav class="pagination-container">
                <ul class="pagination">
                    <% if (hasPrevPage) { %>
                        <li class="page-item">
                            <a class="page-link"
                                href="/shop?page=<%= prevPage %><%= currentCategory ? '&category=' + currentCategory : '' %>">Previous</a>
                        </li>
                        <% } %>

                            <% for (let i=1; i <=totalPages; i++) { %>
                                <% if (i===1 || i===totalPages || (i>= currentPage - 2 && i <= currentPage + 2)) { %>
                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                            <a class="page-link"
                                                href="/shop?page=<%= i %><%= currentCategory ? '&category=' + currentCategory : '' %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } else if (i===currentPage - 3 || i===currentPage + 3) { %>
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                            <% } %>
                                                <% } %>

                                                    <% if (hasNextPage) { %>
                                                        <li class="page-item">
                                                            <a class="page-link"
                                                                href="/shop?page=<%= nextPage %><%= currentCategory ? '&category=' + currentCategory : '' %>">Next</a>
                                                        </li>
                                                        <% } %>
                </ul>

                <div class="pagination-info">
                    Showing <%= ((currentPage - 1) * limit) + 1 %> -
                        <%= Math.min(currentPage * limit, totalProducts) %> of <%= totalProducts %> products
                </div>
            </nav>
            <% } %>

                <!-- Cart Summary -->
                <div class="cart-summary">
                    <h3>Your Cart</h3>
                    <div id="cart-items"></div>
                    <div class="cart-total">
                        <strong>Total: $<span id="cart-total">0.00</span></strong>
                    </div>
                    <a href="/checkout" class="btn btn-primary checkout-btn" style="display: none;">Proceed to
                        Checkout</a>
                </div>
    </div>
</section>

<script>
    // Filters and AJAX loading functionality
    document.addEventListener('DOMContentLoaded', function () {
        const productsContainer = document.getElementById('productsContainer');
        const minPriceValue = document.getElementById('minPriceValue');
        const maxPriceValue = document.getElementById('maxPriceValue');
        const priceRangeMin = document.getElementById('priceRangeMin');
        const priceRangeMax = document.getElementById('priceRangeMax');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        const applyFiltersBtn = document.getElementById('applyFilters');
        const resetFiltersBtn = document.getElementById('resetFilters');

        // Update price display
        function updatePriceDisplay() {
            minPriceValue.textContent = priceRangeMin.value;
            maxPriceValue.textContent = priceRangeMax.value;
        }

        // Initialize price range
        updatePriceDisplay();

        // Price range event listeners
        priceRangeMin.addEventListener('input', function () {
            if (parseInt(this.value) > parseInt(priceRangeMax.value)) {
                priceRangeMax.value = this.value;
            }
            updatePriceDisplay();
        });

        priceRangeMax.addEventListener('input', function () {
            if (parseInt(this.value) < parseInt(priceRangeMin.value)) {
                priceRangeMin.value = this.value;
            }
            updatePriceDisplay();
        });

        // Apply filters
        applyFiltersBtn.addEventListener('click', function () {
            loadProducts();
        });

        // Reset filters
        resetFiltersBtn.addEventListener('click', function () {
            // Use the actual values from the server-side rendering
            priceRangeMin.value = parseFloat(priceRangeMin.getAttribute('min'));
            priceRangeMax.value = parseFloat(priceRangeMax.getAttribute('max'));
            sortBy.value = 'createdAt';
            sortOrder.value = 'desc';
            updatePriceDisplay();
            loadProducts();
        });



        // Load products via AJAX
        function loadProducts() {
            const params = new URLSearchParams(window.location.search);

            // Build query string
            params.set('page', 1); // Reset to first page when filtering
            params.set('minPrice', priceRangeMin.value);
            params.set('maxPrice', priceRangeMax.value);
            params.set('sortBy', sortBy.value);
            params.set('sortOrder', sortOrder.value);

            // Show loading
            productsContainer.innerHTML = '<div class="loading">Loading products...</div>';

            // Make AJAX request
            fetch(`/api/products?${params.toString()}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateProductsDisplay(data);
                        updateURL(params);
                    }
                })
                .catch(error => {
                    console.error('Error loading products:', error);
                    productsContainer.innerHTML = '<div class="error">Error loading products. Please try again.</div>';
                });
        }

        // Update products display
        function updateProductsDisplay(data) {
            const { products, pagination } = data;

            if (products.length === 0) {
                productsContainer.innerHTML = '<div class="no-products"><h3>No products found</h3><p>Try adjusting your filters</p></div>';
                return;
            }

            let html = '';

            products.forEach(product => {
                html += `
            <div class="product-card">
                <div class="product-image">
                    <img src="${product.image}" alt="${product.name}">
                    ${product.stock < 10 ? '<span class="product-badge low-stock">Low Stock</span>' : ''}
                </div>
                <div class="product-info">
                    <h3>${product.name}</h3>
                    <p class="product-category">${product.category}</p>
                    <p class="product-description">${product.description}</p>
                    <div class="product-price">$${product.price.toFixed(2)}</div>
                    <div class="product-rating">
                        ${getStarRating(product.rating)}
                        <span class="rating-count">(${product.reviews} reviews)</span>
                    </div>
                    <div class="product-stock">
                        ${product.stock > 0 ?
                        `<span class="stock-available">In Stock: ${product.stock}</span>` :
                        '<span class="stock-out">Out of Stock</span>'}
                    </div>
                    <button class="btn btn-primary add-to-cart" 
                            data-id="${product._id}"
                            data-product="${product.name}" 
                            data-price="${product.price}"
                            ${product.stock === 0 ? 'disabled' : ''}>
                        ${product.stock === 0 ? 'Out of Stock' : 'Add to Cart'}
                    </button>
                </div>
            </div>`;
            });

            productsContainer.innerHTML = html;

            // Re-attach cart event listeners
            attachCartEventListeners();

            // Update pagination if needed
            updatePagination(pagination);
        }

        // Update the addToCart function to handle quantities
        function addToCart(productId, name, price, quantity = 1) {
            let cart = JSON.parse(localStorage.getItem('golfCart')) || [];

            // Check if product already exists in cart
            const existingItem = cart.find(item => item.productId === productId);

            if (existingItem) {
                existingItem.quantity += quantity;
            } else {
                cart.push({
                    productId: productId,
                    name: name,
                    price: price,
                    quantity: quantity
                });
            }

            localStorage.setItem('golfCart', JSON.stringify(cart));
            updateCartDisplay();

            // Also update session cart (for server-side)
            updateSessionCart(cart);
        }

        // Function to update session cart via AJAX
        function updateSessionCart(cart) {
            fetch('/api/cart/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ cart: cart })
            }).catch(error => console.error('Error updating session cart:', error));
        }
        // Helper function for star rating
        function getStarRating(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(rating)) {
                    stars += '★';
                } else if (i - 0.5 <= rating) {
                    stars += '☆';
                } else {
                    stars += '☆';
                }
            }
            return stars;
        }

        // Update URL without reloading page
        function updateURL(params) {
            const newUrl = `${window.location.pathname}?${params.toString()}`;
            window.history.pushState({ path: newUrl }, '', newUrl);
        }

        // Handle browser back/forward
        window.addEventListener('popstate', function () {
            loadProductsFromURL();
        });

        // Load products from current URL
        function loadProductsFromURL() {
            const params = new URLSearchParams(window.location.search);

            // Get default min/max from the input elements' attributes (set during server-side rendering)
            const defaultMinPrice = parseFloat(priceRangeMin.getAttribute('min'));
            const defaultMaxPrice = parseFloat(priceRangeMax.getAttribute('max'));

            // Update filter controls to match URL, falling back to defaults from attributes
            const minPrice = params.get('minPrice') || defaultMinPrice;
            const maxPrice = params.get('maxPrice') || defaultMaxPrice;
            const sortByParam = params.get('sortBy') || 'createdAt';
            const sortOrderParam = params.get('sortOrder') || 'desc';

            priceRangeMin.value = minPrice;
            priceRangeMax.value = maxPrice;
            sortBy.value = sortByParam;
            sortOrder.value = sortOrderParam;

            updatePriceDisplay();

            // Load products
            productsContainer.innerHTML = '<div class="loading">Loading products...</div>';

            fetch(`/api/products?${params.toString()}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateProductsDisplay(data);
                    }
                })
                .catch(error => {
                    console.error('Error loading products:', error);
                    productsContainer.innerHTML = '<div class="error">Error loading products. Please try again.</div>';
                });
        }

        // Update pagination display
        function updatePagination(pagination) {
            const paginationContainer = document.querySelector('.pagination-container');
            if (!paginationContainer) return;

            let paginationHTML = `
            <nav class="pagination-container">
                <ul class="pagination">`;

            if (pagination.hasPrevPage) {
                paginationHTML += `
                <li class="page-item">
                    <a class="page-link pagination-link" href="#" data-page="${pagination.prevPage}">Previous</a>
                </li>`;
            }

            for (let i = 1; i <= pagination.totalPages; i++) {
                if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 2 && i <= pagination.currentPage + 2)) {
                    paginationHTML += `
                <li class="page-item ${i === pagination.currentPage ? 'active' : ''}">
                    <a class="page-link pagination-link" href="#" data-page="${i}">${i}</a>
                </li>`;
                } else if (i === pagination.currentPage - 3 || i === pagination.currentPage + 3) {
                    paginationHTML += `
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>`;
                }
            }

            if (pagination.hasNextPage) {
                paginationHTML += `
                <li class="page-item">
                    <a class="page-link pagination-link" href="#" data-page="${pagination.nextPage}">Next</a>
                </li>`;
            }

            paginationHTML += `
                </ul>
                <div class="pagination-info">
                    Showing ${((pagination.currentPage - 1) * pagination.limit) + 1} - 
                    ${Math.min(pagination.currentPage * pagination.limit, pagination.totalProducts)} 
                    of ${pagination.totalProducts} products
                </div>
            </nav>`;

            paginationContainer.outerHTML = paginationHTML;

            // Attach pagination event listeners
            attachPaginationEventListeners();
        }

        // Attach pagination event listeners
        function attachPaginationEventListeners() {
            document.querySelectorAll('.pagination-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const page = parseInt(this.getAttribute('data-page'));

                    // Update URL with new page
                    const params = new URLSearchParams(window.location.search);
                    params.set('page', page);

                    // Load products for the new page
                    fetch(`/api/products?${params.toString()}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                updateProductsDisplay(data);
                                window.history.pushState({ path: window.location.href }, '', `?${params.toString()}`);
                                window.scrollTo({ top: 0, behavior: 'smooth' });
                            }
                        })
                        .catch(error => {
                            console.error('Error loading page:', error);
                        });
                });
            });
        }

        // Attach cart event listeners
        function attachCartEventListeners() {
            document.querySelectorAll('.add-to-cart').forEach(button => {
                button.addEventListener('click', function () {
                    if (this.disabled) return;

                    const product = this.getAttribute('data-product');
                    const price = parseFloat(this.getAttribute('data-price'));

                    let cart = JSON.parse(localStorage.getItem('golfCart')) || [];
                    cart.push({ product, price });
                    localStorage.setItem('golfCart', JSON.stringify(cart));

                    updateCartDisplay();
                    alert(`${product} added to cart!`);
                });
            });
        }

        // Update cart display
        function updateCartDisplay() {
            const cart = JSON.parse(localStorage.getItem('golfCart')) || [];
            const cartItems = document.getElementById('cart-items');
            const cartTotal = document.getElementById('cart-total');
            const checkoutBtn = document.querySelector('.checkout-btn');

            if (cart.length === 0) {
                cartItems.innerHTML = '<p>Your cart is empty</p>';
                if (checkoutBtn) checkoutBtn.style.display = 'none';
            } else {
                let itemsHTML = '';
                let total = 0;

                cart.forEach(item => {
                    itemsHTML += `<div class="cart-item">${item.product} - $${item.price.toFixed(2)}</div>`;
                    total += item.price;
                });

                cartItems.innerHTML = itemsHTML;
                cartTotal.textContent = total.toFixed(2);
                if (checkoutBtn) checkoutBtn.style.display = 'block';
            }
        }

        // Initial cart display
        updateCartDisplay();

        // Initial pagination event listeners
        attachPaginationEventListeners();
    });
</script>

<style>
    .filters-section {
        margin-bottom: 30px;
    }

    .filter-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .filter-group {
        margin-bottom: 20px;
    }

    .filter-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .category-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .category-filter {
        padding: 6px 12px;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 20px;
        text-decoration: none;
        color: #495057;
        font-size: 14px;
        transition: all 0.3s;
    }

    .category-filter:hover,
    .category-filter.active {
        background: #28a745;
        color: white;
        border-color: #28a745;
    }

    .price-range {
        position: relative;
        padding: 20px 0;
    }


    .price-range input[type="range"]::-webkit-slider-thumb {
        pointer-events: all;
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        background: #28a745;
        border-radius: 50%;
        cursor: pointer;
    }

    .price-range input[type="range"]::-moz-range-thumb {
        pointer-events: all;
        width: 18px;
        height: 18px;
        background: #28a745;
        border-radius: 50%;
        cursor: pointer;
    }

    .price-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        font-size: 14px;
        color: #666;
    }

    .product-category {
        font-size: 14px;
        color: #666;
        margin-bottom: 8px;
    }

    .product-stock {
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stock-available {
        color: #28a745;
    }

    .stock-out {
        color: #dc3545;
    }

    .low-stock {
        background: #ffc107;
    }

    .pagination-container {
        margin: 40px 0;
        text-align: center;
    }

    .pagination-info {
        margin-top: 10px;
        font-size: 14px;
        color: #666;
    }

    .loading,
    .error,
    .no-products {
        text-align: center;
        padding: 40px;
        grid-column: 1 / -1;
    }

    .loading {
        color: #666;
    }

    .error {
        color: #dc3545;
    }

    .form-select {
        display: inline-block;
        width: auto;
        margin-right: 10px;
    }

    #applyFilters,
    #resetFilters {
        margin-top: 10px;
    }
</style>