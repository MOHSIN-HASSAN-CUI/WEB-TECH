<!-- Products Section -->
<section class="products-section">
    <div class="container">
        <h1 class="text-center">Golf Equipment & Accessories</h1>
        <p class="text-center section-subtitle">Premium golf gear for professionals and enthusiasts</p>
        
        <div class="products-grid">
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div class="product-image">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <% if (product.id === 1) { %>
                                <span class="product-badge">Bestseller</span>
                            <% } else if (product.id === 2) { %>
                                <span class="product-badge">New</span>
                            <% } else if (product.id === 5) { %>
                                <span class="product-badge">Sale</span>
                            <% } %>
                        </div>
                        <div class="product-info">
                            <h3><%= product.name %></h3>
                            <p class="product-description"><%= product.description %></p>
                            <div class="product-price">
                                <% if (product.id === 5) { %>
                                    <span class="original-price">$129.99</span>
                                    <span class="sale-price">$<%= product.price.toFixed(2) %></span>
                                <% } else { %>
                                    $<%= product.price.toFixed(2) %>
                                <% } %>
                            </div>
                            <div class="product-rating">
                                ★★★★☆ <span class="rating-count">(<%= Math.floor(Math.random() * 100) + 20 %> reviews)</span>
                            </div>
                            <button class="btn btn-primary add-to-cart" 
                                    data-product="<%= product.name %>" 
                                    data-price="<%= product.price %>">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-center">No products available at the moment.</p>
            <% } %>
        </div>
        
        <!-- Cart Summary -->
        <div class="cart-summary">
            <h3>Your Cart</h3>
            <div id="cart-items"></div>
            <div class="cart-total">
                <strong>Total: $<span id="cart-total">0.00</span></strong>
            </div>
            <a href="/checkout" class="btn btn-primary checkout-btn" style="display: none;">Proceed to Checkout</a>
        </div>
    </div>
</section>