<div class="row mt-5">
       <div class="col-md-6 m-auto">
              <div class="card card-body border-danger">
                     <h1 class="text-center mb-3 text-danger"><i class="fas fa-user-shield"></i> Admin Login</h1>
                     <p class="text-center text-muted">Restricted Access Area</p>

                     <% if (typeof error !='undefined' && error) { %>
                            <div class="alert alert-danger" role="alert">
                                   <%= error %>
                            </div>
                            <% } %>

                                   <% if (locals.user && !locals.user.isAdmin) { %>
                                          <div class="alert alert-warning text-center">
                                                 <h4><i class="fas fa-exclamation-triangle"></i> Action Required</h4>
                                                 <p class="mb-3">First logout as user <strong>
                                                               <%= user.name %>
                                                        </strong></p>
                                                 <a href="/logout" class="btn btn-warning w-100">Logout Now</a>
                                          </div>
                                          <% } else { %>
                                                 <div class="alert alert-info border-info" role="alert">
                                                        <strong><i class="fas fa-key"></i> Instructor
                                                               Credentials:</strong><br>
                                                        Email: <code>admin@golfshop.com</code><br>
                                                        Password: <code>admin123</code>
                                                 </div>

                                                 <form action="/admin/login" method="POST">
                                                        <div class="form-group mb-3">
                                                               <label for="email" class="form-label">Admin Email</label>
                                                               <input type="email" id="email" name="email"
                                                                      class="form-control"
                                                                      placeholder="admin@golfshop.com"
                                                                      value="<%= typeof email != 'undefined' ? email : '' %>"
                                                                      required />
                                                        </div>
                                                        <div class="form-group mb-4">
                                                               <label for="password" class="form-label">Password</label>
                                                               <input type="password" id="password" name="password"
                                                                      class="form-control" placeholder="admin123"
                                                                      required />
                                                        </div>
                                                        <button type="submit"
                                                               class="btn btn-danger btn-block w-100">Access
                                                               Dashboard</button>
                                                 </form>
                                                 <p class="lead mt-4 text-center">
                                                        Not an Admin? <a href="/login">Customer Login</a>
                                                 </p>
                                                 <% } %>
              </div>
       </div>
</div>