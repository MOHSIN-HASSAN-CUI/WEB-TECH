<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Order Details</h5>
    </div>
    <div class="card-body">
        <!-- Order Information -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h6>Order Information</h6>
                <table class="table table-sm">
                    <tr>
                        <th>Order ID:</th>
                        <td><%= order.orderId %></td>
                    </tr>
                    <tr>
                        <th>Customer Email:</th>
                        <td><%= order.customerEmail %></td>
                    </tr>
                    <tr>
                        <th>Order Date:</th>
                        <td><%= new Date(order.createdAt).toLocaleString() %></td>
                    </tr>
                    <tr>
                        <th>Status:</th>
                        <td>
                            <span class="badge <%= 
                                order.status === 'Delivered' ? 'bg-success' : 
                                order.status === 'Processing' ? 'bg-warning' : 'bg-info'
                            %>">
                                <%= order.status %>
                            </span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <h6>Payment Summary</h6>
                <table class="table table-sm">
                    <tr>
                        <th>Subtotal:</th>
                        <td>$<%= order.subtotal.toFixed(2) %></td>
                    </tr>
                    <% if (order.discount > 0) { %>
                        <tr>
                            <th>Discount:</th>
                            <td class="text-danger">-$<%= order.discount.toFixed(2) %></td>
                        </tr>
                        <tr>
                            <th>Coupon:</th>
                            <td><span class="badge bg-success"><%= order.couponCode %></span></td>
                        </tr>
                    <% } %>
                    <tr>
                        <th>Total:</th>
                        <td><strong>$<%= order.total.toFixed(2) %></strong></td>
                    </tr>
                </table>
            </div>
        </div>
        
        <!-- Order Items -->
        <h6>Order Items</h6>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(item => { %>
                        <tr>
                            <td><%= item.name %></td>
                            <td>$<%= item.price.toFixed(2) %></td>
                            <td><%= item.quantity %></td>
                            <td>$<%= item.subtotal.toFixed(2) %></td>
                        </tr>
                    <% }); %>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td><strong>$<%= order.total.toFixed(2) %></strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        
        <!-- Status Update Form -->
        <div class="mt-4">
            <h6>Update Status</h6>
            <form id="statusForm" class="row g-3">
                <div class="col-md-3">
                    <select class="form-select" id="newStatus">
                        <option value="Placed" <%= order.status === 'Placed' ? 'selected' : '' %>>Placed</option>
                        <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                        <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
        
        <!-- Back Button -->
        <div class="mt-4">
            <a href="/admin/orders" class="btn btn-secondary">
                ← Back to Orders
            </a>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('#statusForm').submit(function(e) {
        e.preventDefault();
        
        const newStatus = $('#newStatus').val();
        
        if (confirm(`Change order status to "${newStatus}"?`)) {
            $.ajax({
                url: `/admin/api/orders/<%= order._id %>/status`,
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ status: newStatus }),
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        // Update status badge
                        location.reload();
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    toastr.error('Error updating status');
                }
            });
        }
    });
});
</script>